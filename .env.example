# Copy this file to .env and provide your own API key.

GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=gemini-3.6-flash

# MLAI-027.6 controlled pilot operations. Keep secrets outside source control.
MLAI_ENVIRONMENT=synthetic-pilot
MLAI_DATABASE_PATH=database/marketinglabai.db
MLAI_BACKUP_DIRECTORY=C:/Ai Projects/ToolkitTemp/MarketingLabAIBackups
MLAI_PUBLIC_ORIGIN=http://127.0.0.1:8080
MLAI_TRUST_PROXY_TLS=false
MLAI_SESSION_SECRET=replace-with-at-least-32-random-secret-characters
MLAI_SESSION_TTL_SECONDS=3600
MLAI_RATE_LIMIT_REQUESTS=60
MLAI_RATE_LIMIT_WINDOW_SECONDS=60
MLAI_MAX_REQUEST_BYTES=1048576
MLAI_IDENTITY_PROVIDER=google-cloud-identity-platform
MLAI_IDENTITY_ADAPTER_FACTORY=app.identity.google_cloud:create_google_cloud_adapter
MLAI_GOOGLE_CLOUD_PROJECT_ID=marketinglabai-identity-dev
# Browser identifiers are public but remain environment-specific and restricted.
MLAI_GOOGLE_WEB_API_KEY=replace-with-restricted-firebase-browser-key
MLAI_GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
MLAI_GOOGLE_AUTH_DOMAIN=marketinglabai-identity-dev.firebaseapp.com
MLAI_GOOGLE_MAX_AUTH_AGE_SECONDS=3600
# Boolean evidence only; keep {} until each controlled rehearsal is complete.
MLAI_SECURITY_EVIDENCE_JSON={}
# Exact deployed Git commit used to bind immutable readiness evidence.
MLAI_DEPLOYMENT_COMMIT=unrecorded
# Optional future adapter only; Microsoft Entra is not the selected deployment.
MLAI_ENTRA_TENANT_ID=
MLAI_ENTRA_TENANT_SUBDOMAIN=
MLAI_ENTRA_CLIENT_ID=
MLAI_PROVIDER_REGISTRY_FACTORY=deployment.providers:create_registry
# JSON maps approved tenant IDs to SHA-256 invitation-code hashes. Never commit codes.
MLAI_FOUNDER_INVITATION_HASHES_JSON={"strand-auto-parts-pilot":"replace-with-64-character-sha256","velani-wholesale-pilot":"replace-with-64-character-sha256"}
MLAI_ALLOW_REAL_CUSTOMER_DATA=false

# MLAI-031.1 controlled-hosting target. These values describe a proposed
# deployment only; they never authorize API enablement, build or deployment.
MLAI_CLOUD_PROJECT_ID=marketinglabai-identity-dev
MLAI_CLOUD_REGION=africa-south1
MLAI_CLOUD_RUN_SERVICE=marketinglabai-velani-pilot
MLAI_PERSISTENCE_BACKEND=postgresql
# Secret value supplied only by Secret Manager in the controlled environment.
MLAI_DATABASE_URL=
MLAI_DATABASE_SECRET_REFERENCE=projects/marketinglabai-identity-dev/secrets/database-url
MLAI_CLOUD_SQL_INSTANCE=marketinglabai-identity-dev:africa-south1:velani-pilot-db
MLAI_CLOUD_RUN_MAX_INSTANCES=1
MLAI_CLOUD_RUN_MIN_INSTANCES=0
MLAI_CLOUD_RUN_CONCURRENCY=8
MLAI_CLOUD_RUN_CPU=1
MLAI_CLOUD_RUN_MEMORY_MIB=512
MLAI_MONTHLY_BUDGET_ZAR=500
MLAI_SECRET_BINDINGS_JSON={}
# Must remain false until every repository and recovery path passes PostgreSQL.
MLAI_DURABLE_ADAPTER_VERIFIED=false
MLAI_DURABLE_ADAPTER_EVIDENCE_REFERENCE=
