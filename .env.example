# Copy this file to .env and provide your own API key.

GEMINI_API_KEY=replace-with-your-api-key
GEMINI_MODEL=gemini-3.6-flash

# MLAI-027.6 controlled pilot operations. Keep secrets outside source control.
MLAI_ENVIRONMENT=synthetic-pilot
MLAI_DATABASE_PATH=database/marketinglabai.db
MLAI_BACKUP_DIRECTORY=C:/Ai Projects/ToolkitTemp/MarketingLabAIBackups
MLAI_PUBLIC_ORIGIN=https://pilot.example.com
MLAI_TRUST_PROXY_TLS=false
MLAI_SESSION_SECRET=replace-with-at-least-32-random-secret-characters
MLAI_SESSION_TTL_SECONDS=3600
MLAI_RATE_LIMIT_REQUESTS=60
MLAI_RATE_LIMIT_WINDOW_SECONDS=60
MLAI_IDENTITY_PROVIDER=microsoft-entra-external-id
MLAI_IDENTITY_ADAPTER_FACTORY=app.identity.entra:create_entra_adapter
MLAI_ENTRA_TENANT_ID=replace-after-external-tenant-creation
MLAI_ENTRA_TENANT_SUBDOMAIN=replace-after-external-tenant-creation
MLAI_ENTRA_CLIENT_ID=replace-after-app-registration
MLAI_PROVIDER_REGISTRY_FACTORY=deployment.providers:create_registry
# JSON maps approved tenant IDs to SHA-256 invitation-code hashes. Never commit codes.
MLAI_FOUNDER_INVITATION_HASHES_JSON={"strand-auto-parts-pilot":"replace-with-64-character-sha256","velani-wholesale-pilot":"replace-with-64-character-sha256"}
MLAI_ALLOW_REAL_CUSTOMER_DATA=false
